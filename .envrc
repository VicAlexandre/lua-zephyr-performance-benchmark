watch_file pyproject.toml uv.lock .python-version

uv sync --quiet
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

export ZEPHYR_TOOLCHAIN_VARIANT=zephyr
export ZEPHYR_SDK_INSTALL_DIR="${ZEPHYR_SDK_INSTALL_DIR:-$HOME/zephyr-sdk-1.0.0}"

export OPENOCD="${OPENOCD:-/usr/local/bin/openocd}"
export OPENOCD_SCRIPTS="${OPENOCD_SCRIPTS:-/usr/local/share/openocd/scripts}"

source_env_if_exists .envrc.local
